# Copy this file to .env and fill in your real key. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase web config for the Cup admin sign-in. Leave blank in git.
# The admin account is created in Firebase Auth, not by this app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
