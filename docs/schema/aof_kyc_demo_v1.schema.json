      "enum_ref": "journey_mode",
      "required": true,
      "group": "identity",
      "section": "sec_intent",
      "validation": {
        "enum": true
      },
      "voice_hints": [
        "open a savings account",
        "update KYC",
        "re-KYC",
        "KYC updation"
      ],
      "bank_varies": true,
      "notes": "Maps to AO-SB vs KYC-UPD/rekyc hubs; bank forms differ."
    },
    {
      "id": "applicant_full_name",
