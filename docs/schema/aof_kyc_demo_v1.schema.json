{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://builders-cup.local/schemas/aof_kyc_demo_v1.schema.json",
  "title": "aof_kyc_demo_v1",
  "description": "Demo-ready field schema for Builders Cup voice-to-form MVP: Account Opening Form (AOF) + KYC for resident individuals. English-first, India BFSI. Confirm-before-submit; no live bank submit. Field labels and presence vary by bank — do not invent form IDs.",
  "version": "1.0.0",
  "form_type": "aof_kyc",
  "taxonomy_codes": [
    "AO-SB",
    "KYC-UPD"
  ],
  "locale": "en-IN",
  "demo_constraints": {
    "confirm_before_submit": true,
    "live_bank_submit": false,
    "invented_form_ids": false,
    "bank_varies_copy": "Fields and labels vary by bank",
    "excluded_from_this_schema": [
      "NEFT/RTGS/IMPS transfer forms",
      "loans (LN-*)",
      "SCSS (DEP-SCSS)",
      "Form 15G/15H / tax TDS declaration packs",
      "nomination (NOM-*) — stretch later"
    ],
    "gates_backend": "gemini_structured_json_emulating_choice_score_noul"
  },
  "public_hubs": [
    {
      "bank": "HDFC",
      "cite_as": "HDFC Forms Centre — Personal",
      "url": "https://www.hdfc.bank.in/resources/forms-centre/forms-centre-personal",
      "use_for": [
        "AOF Individuals",
        "REKYC Individuals",
        "KYC / customer profile samples"
      ],
      "do_not": "Do not invent HDFC form numbers; cite hub + titled PDF name only."
    },
    {
      "bank": "SBI",
      "cite_as": "SBI KYC Documents — Individuals",
      "url": "https://sbi.bank.in/web/personal-banking/information-services/kyc-guidelines/kyc-documents-individuals",
      "use_for": [
        "OVD list for individuals",
        "KYC updation annexure pointers"
      ],
      "related_hub": "https://sbi.bank.in/web/customer-care/forms-and-applications-in-multiple-languages",
      "do_not": "Do not invent SBI form codes; cite hub + titled form name (e.g. Account Opening Form – Resident Individual – English)."
    },
    {
      "bank": "ICICI",
      "cite_as": "ICICI Bank Personal Banking Form Center",
      "url": "https://www.icici.bank.in/personal-banking/form-center",
      "use_for": [
        "Re-KYC / Customer Information Updation — Individual",
        "documentation list for savings KYC"
      ],
      "related_docs_page": "https://www.icici.bank.in/personal-banking/accounts/savings-account/documentation",
      "do_not": "Do not invent ICICI form numbers; Form Center titles are the citation surface."
    }
  ],
  "field_groups": [
    "identity",
    "address",
    "contact",
    "account_refs",
    "kyc_ovd",
    "profile_light",
    "confirm_gates"
  ],
  "sections": [
    {
      "id": "sec_intent",
      "title_en": "Journey intent",
      "description_en": "AOF new account vs KYC / Re-KYC update. Voice routes here first.",
      "order": 1
    },
    {
      "id": "sec_identity",
      "title_en": "Identity",
      "description_en": "Name, DOB, PAN/Form 60, CKYC if known.",
      "order": 2,
      "group": "identity"
    },
    {
      "id": "sec_contact",
      "title_en": "Contact",
      "description_en": "Registered mobile and email for OTP / bank comms.",
      "order": 3,
      "group": "contact"
    },
    {
      "id": "sec_address",
      "title_en": "Address",
      "description_en": "Current (communication) address; permanent if different.",
      "order": 4,
      "group": "address"
    },
    {
      "id": "sec_kyc_ovd",
      "title_en": "KYC Officially Valid Documents",
      "description_en": "RBI OVD slots for proof of identity and address. Aadhaar optional with alternatives.",
      "order": 5,
      "group": "kyc_ovd"
    },
    {
      "id": "sec_account_refs",
      "title_en": "Account / customer references",
      "description_en": "Existing CIF/customer ID if any; product intent for AOF.",
      "order": 6,
      "group": "account_refs"
    },
    {
      "id": "sec_profile_light",
      "title_en": "Light profile & declarations",
      "description_en": "Occupation, PEP, India-only tax resident flag. No Form 15G/loan packs.",
      "order": 7,
      "group": "profile_light"
    },
    {
      "id": "sec_confirm",
      "title_en": "Confirm before draft",
      "description_en": "Read-back and explicit draft-only acknowledgement. Never live bank submit.",
      "order": 8,
      "group": "confirm_gates"
    }
  ],
  "enums": {
    "journey_mode": [
      "account_opening",
      "kyc_update",
      "rekyc"
    ],
    "gender": [
      "female",
      "male",
      "other",
      "prefer_not_to_say"
    ],
    "residential_status": [
      "resident_individual"
    ],
    "ovd_type": [
      "passport",
      "driving_licence",
      "proof_of_possession_of_aadhaar",
      "voter_id",
      "nrega_job_card",
      "npr_letter"
    ],
    "account_product_intent": [
      "regular_savings",
      "salary_savings",
      "bsbda",
      "individual_current",
      "unspecified_varies_by_bank"
    ],
    "occupation_bucket": [
      "salaried",
      "self_employed",
      "professional",
      "student",
      "homemaker",
      "retired",
      "other"
    ],
    "indian_state_hint": "Use full English state/UT name as spoken; normalize in code."
  },
  "fields": [
