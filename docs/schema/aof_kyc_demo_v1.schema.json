        "retired"
      ],
      "bank_varies": true
    },
    {
      "id": "pep_declaration",
      "label_en": "Are you a Politically Exposed Person (PEP)?",
      "type": "boolean",
      "required": true,
      "group": "profile_light",
      "section": "sec_profile_light",
      "validation": {},
      "voice_hints": [
        "politically exposed",
        "PEP",
        "not a PEP"
      ],
      "bank_varies": true
    },
    {
      "id": "tax_resident_india_only",
      "label_en": "Tax resident of India only (no other country)",
      "type": "boolean",
      "required": true,
      "group": "profile_light",
      "section": "sec_profile_light",
      "validation": {},
      "voice_hints": [
        "tax resident of India only",
        "FATCA",
        "no foreign tax residency"
      ],
      "bank_varies": true,
      "notes": "Light FATCA/CRS flag only. Full FATCA packs / Form 15G excluded from this schema."
    },
    {
      "id": "bank_hint",
      "label_en": "Bank this draft is styled for (demo)",
      "type": "string",
      "required": false,
      "group": "account_refs",
      "section": "sec_account_refs",
      "validation": {
        "enum_soft": [
          "HDFC",
          "SBI",
          "ICICI",
          "unspecified"
        ]
      },
      "voice_hints": [
        "for HDFC",
        "State Bank",
        "ICICI"
      ],
      "bank_varies": true,
      "notes": "UI copy must still say fields vary by bank; hint only affects sample labels."
    },
    {
      "id": "readback_confirmed",
      "label_en": "I confirm the read-back of key details is correct",
      "type": "boolean",
      "required": true,
      "group": "confirm_gates",
      "section": "sec_confirm",
      "validation": {
        "must_be_true_to_finalize": true
      },
      "voice_hints": [
        "yes that is correct",
        "confirm",
        "looks good"
      ],
      "bank_varies": false
    },
    {
      "id": "draft_only_ack",
      "label_en": "I understand this creates a draft only — not submitted to any bank",
      "type": "boolean",
      "required": true,
      "group": "confirm_gates",
      "section": "sec_confirm",
      "validation": {
        "must_be_true_to_finalize": true
      },
      "voice_hints": [
        "draft only",
        "do not submit to bank",
        "just prepare the form"
      ],
      "bank_varies": false
    },
    {
      "id": "no_live_submit_ack",
      "label_en": "I am not asking the agent to send this to the bank live",
      "type": "boolean",
      "required": true,
      "group": "confirm_gates",
      "section": "sec_confirm",
      "validation": {
        "must_be_true_to_finalize": true
      },
      "voice_hints": [
        "don't send to bank",
        "no live submit"
      ],
      "bank_varies": false
    }
  ],
  "confirm_gates": {
    "description": "Gemini structured JSON shaped like TypeSafe Choice/Score/Noul. Application code owns thresholds; no live Jev API required.",
    "emit_shape": {
      "answers": {
        "<gate_id>": {
          "type": "choice|score|noul",
          "choice": "<label or null>",
          "probabilities": {},
          "confidence": 0.0,
          "score": null,
          "noul": null
        }
      }
    },
    "gates": [
      {
        "id": "journey_type",
        "primitive": "choice",
        "options": [
          "account_opening",
          "kyc_update",
          "rekyc",
          "other"
        ],
        "purpose": "Route to AOF vs KYC/Re-KYC template",
        "code_policy": "If choice=other or confidence < 0.7 → clarify in voice; do not fill."
      },
      {
        "id": "noul_pan_plausible",
        "primitive": "noul",
        "purpose": "Soft check spoken PAN before regex",
        "code_policy": "Hard PAN regex stays in code; Noul is soft only."
      },
      {
        "id": "noul_mobile_is_registered_claim",
        "primitive": "noul",
        "purpose": "User asserts mobile is bank-registered",
        "code_policy": "Demo trusts claim; never call bank APIs."
      },
      {
        "id": "noul_ovd_type_clear",
        "primitive": "noul",
        "purpose": "OVD type clearly one of the six public OVDs",
        "code_policy": "Mid band → re-ask with enum list."
      },
      {
        "id": "score_completeness",
        "primitive": "score",
        "levels": [
          "empty",
          "partial_core",
          "demo_ready",
          "full_bank_packet"
        ],
        "purpose": "UI progress + gate read-back",
        "code_policy": "Only demo_ready+ may enter read-back."
      },
      {
        "id": "noul_ready_for_readback",
        "primitive": "noul",
        "purpose": "All required demo slots present and coherent",
        "code_policy": "Act if noul ≫ 0.9 else ask missing via incomplete_routing."
      },
      {
        "id": "score_confirmation_clarity",
        "primitive": "score",
        "levels": [
          "unclear",
          "hedged",
          "clear_yes"
        ],
        "purpose": "Quality of user confirm utterance",
        "code_policy": "Require clear_yes + high confidence before draft emit."
      },
      {
        "id": "noul_user_confirmed_readback",
        "primitive": "noul",
        "purpose": "Explicit confirm after TTS read-back of name, DOB, mobile last-4, OVD type, product intent",
        "code_policy": "Must be ≫ 0.9 with score_confirmation_clarity=clear_yes."
      },
      {
        "id": "noul_requests_live_bank_submit",
        "primitive": "noul",
        "purpose": "Guardrail: user asked to submit to bank",
        "code_policy": "If high → refuse; explain draft-only; set no_live_submit_ack false until re-ack."
      },
      {
        "id": "noul_out_of_scope_excluded_product",
        "primitive": "noul",
        "purpose": "Detect NEFT/loans/SCSS/15G/nomination asks",
        "code_policy": "If high → say stretch later / out of this MVP schema; stay on AOF+KYC."
      }
    ],
    "finalize_rule": {
      "required_field_flags": [
        "readback_confirmed",
        "draft_only_ack",
        "no_live_submit_ack"
      ],
      "required_gate_outcomes": [
        "score_completeness >= demo_ready",
        "noul_user_confirmed_readback ≫ 0.9",
        "score_confirmation_clarity == clear_yes",
        "noul_requests_live_bank_submit ≪ 0.1"
      ],
      "on_pass": "Emit draft JSON/PDF fields only. Never POST to bank.",
      "on_fail": "Re-enter incomplete_routing or re-confirm."
    }
  },
  "incomplete_routing": {
    "description": "Gemini Choice next_ask + priority list when required slots missing.",
    "choice_next_ask": {
      "primitive": "choice",
      "id": "next_ask",
      "options_from": "missing_required_field_ids",
      "fallback_priority": [
        "journey_mode",
        "applicant_full_name",
        "dob",
        "mobile_registered",
        "pan_available",
        "pan_number",
        "form60_declared",
        "addr_current_line1",
        "addr_current_city",
        "addr_current_state",
        "addr_current_pin",
        "addr_permanent_same_as_current",
        "ovd_poi_type",
        "ovd_poi_number",
        "ovd_poa_same_as_poi",
        "photo_consent",
        "ovd_originals_ack",
        "existing_bank_customer",
        "customer_id_cif",
        "account_product_intent",
        "pep_declaration",
        "tax_resident_india_only",
        "residential_status",
        "readback_confirmed",
        "draft_only_ack",
        "no_live_submit_ack"
      ]
    },
    "hints": [
      {
        "when_missing": [
          "pan_number",
          "form60_declared"
        ],
        "ask_en": "Do you have a PAN, or should we note Form 60 for no PAN?"
      },
      {
        "when_missing": [
          "ovd_poi_type"
        ],
        "ask_en": "Which officially valid document will you use for identity — passport, driving licence, Aadhaar proof, voter ID, NREGA job card, or NPR letter?"
      },
      {
        "when_missing": [
          "addr_current_pin"
        ],
        "ask_en": "What is the six-digit PIN code for your current address?"
      },
      {
        "when_missing": [
          "account_product_intent"
        ],
        "if": {
          "journey_mode": "account_opening"
        },
        "ask_en": "Is this for a regular savings, salary, basic savings (BSBDA), or individual current account? Exact product names vary by bank."
      },
      {
        "when_missing": [
          "customer_id_cif"
        ],
        "if": {
          "existing_bank_customer": true
        },
        "ask_en": "What is your customer ID or CIF, if you have it handy?"
      },
      {
        "when_score": "partial_core",
        "ask_en": "A few required KYC details are still missing. Shall we continue with identity, or jump to your address and documents?"
      },
      {
        "when_excluded_intent": true,
        "ask_en": "This demo covers account opening and KYC only. Nomination, NEFT, loans, SCSS, and Form 15G are stretch items for later."
      }
    ]
  },
