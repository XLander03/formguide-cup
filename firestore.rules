rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    // Public read of published documents only. Writes require an admin custom claim.
    // This file is not deployed by this change — do not run firebase deploy for it.
    match /banks/{bankId} {
      allow read: if isPublished();
      allow create, update, delete: if isAdmin();
    }

    match /forms/{formId} {
      allow read: if isPublished();
      allow create, update, delete: if isAdmin();

      match /versions/{versionId} {
        allow read: if isPublished();
        allow create, update, delete: if isAdmin();
      }
    }

    match /fieldLibrary/{fieldId} {
      allow read: if isPublished();
      allow create, update, delete: if isAdmin();
    }
  }
}
