    },
    {
      "id": "ovd_poa_type",
      "label_en": "Proof of address \u2014 OVD type",
      "type": "enum",
      "required": false,
      "required_if": {
        "ovd_poa_same_as_poi": false
      },
      "group": "kyc_ovd",
      "validation": {
        "enum": true
      },
