      "label_en": "Permanent address same as current?",
      "type": "boolean",
      "required": true,
      "required_if": null,
      "group": "address",
      "validation": {},
      "bank_varies": false
    },
    {
      "id": "addr_permanent_line1",
      "label_en": "Permanent address \u2014 line 1",
      "type": "string",
      "required": false,
      "required_if": {
        "addr_permanent_same_as_current": false
      },
      "group": "address",
      "validation": {
        "minLength": 3,
        "maxLength": 120
      },
      "bank_varies": false
    },
    {
      "id": "addr_permanent_city",
      "label_en": "Permanent city / town",
      "type": "string",
      "required": false,
      "required_if": {
        "addr_permanent_same_as_current": false
      },
      "group": "address",
      "validation": {
        "minLength": 2,
        "maxLength": 60
      },
      "bank_varies": false
    },
    {
      "id": "addr_permanent_state",
      "label_en": "Permanent state / UT",
      "type": "string",
      "required": false,
      "required_if": {
        "addr_permanent_same_as_current": false
      },
      "group": "address",
      "validation": {
        "minLength": 2,
        "maxLength": 60
      },
