{
  "title": "nomination_savings_demo_v1",
  "description": "Voice draft for adding or changing one nominee on a savings account the customer already holds. Field set follows public Indian bank nomination forms (statutory DA-1 style and bank variants such as deposit nomination, cancellation, and variation). This is not a bank form number. Fields vary by bank. Confirm before save. Never submit live.",
  "version": "1.0.0",
  "form_type": "nomination_savings",
  "locale": "en-IN",
  "demo_constraints": {
    "confirm_before_submit": true,
    "live_bank_submit": false,
    "invented_form_ids": false,
    "bank_varies_copy": "Fields vary by bank.",
    "single_nominee": true,
    "reference": "Public nomination forms for savings deposits. Labels and extra columns differ by bank."
  },
  "public_hubs": [
    {
      "bank": "various",
      "cite_as": "Banking Companies (Nomination) Rules — Form DA-1 style nomination for deposits",
      "use_for": ["account holder", "account number", "nominee name", "relationship", "date of birth", "address", "guardian if the nominee is a minor"]
    },
    {
      "bank": "Kotak",
      "cite_as": "Form for nomination, cancellation of nomination and variation of nomination in respect of bank deposits"
    },
    {
      "bank": "Axis",
      "cite_as": "Nomination Form"
    },
    {
      "bank": "HDFC",
      "cite_as": "Multiple Nomination Form"
    }
  ],
  "enums": {
    "nominee_relationship": [
      "wife",
      "husband",
      "son",
      "daughter",
      "father",
      "mother",
      "brother",
      "sister",
      "other"
    ]
  },
  "field_groups": ["account", "nominee", "guardian", "confirm_gates"],
  "sections": [
    { "id": "account", "title_en": "Account", "order": 1 },
    { "id": "nominee", "title_en": "Nominee", "order": 2 },
    { "id": "guardian", "title_en": "Guardian", "order": 3 },
    { "id": "confirm_gates", "title_en": "Confirm", "order": 4 }
  ],
  "fields": [
    {
      "id": "account_holder_name",
      "label_en": "Account holder name",
      "label_hi": "खाताधारक का नाम",
      "type": "string",
      "required": true,
      "group": "account",
      "section": "account",
      "bank_varies": true,
      "voice_hints": ["as it appears on the savings account"],
      "ask_en": "What is the account holder's name?",
      "ask_hi": "खाताधारक का नाम बताएं।"
    },
    {
      "id": "account_number",
      "label_en": "Account number",
      "label_hi": "खाता संख्या",
      "type": "string",
      "required": true,
      "group": "account",
      "section": "account",
      "bank_varies": true,
      "voice_hints": ["savings account number"],
      "ask_en": "What is the savings account number?",
      "ask_hi": "बचत खाते की खाता संख्या बताएं।",
      "notes": "Length and check digits vary by bank. Reference capture is 9 to 18 digits."
    },
    {
      "id": "customer_id",
      "label_en": "Customer ID",
      "label_hi": "ग्राहक आईडी",
      "type": "string",
      "required": true,
      "group": "account",
      "section": "account",
      "bank_varies": true,
      "voice_hints": ["customer ID or CIF"],
      "ask_en": "What is the customer ID?",
      "ask_hi": "ग्राहक आईडी बताएं।"
