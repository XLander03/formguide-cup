      "group": "nominee",
      "section": "nominee",
      "bank_varies": true,
      "voice_hints": ["wife, husband, son, daughter, father, mother, brother, sister"],
      "ask_en": "What is the nominee's relationship to the account holder?",
      "ask_hi": "नॉमिनी का रिश्ता क्या है?"
    },
    {
      "id": "nominee_dob",
      "label_en": "Nominee date of birth",
      "label_hi": "नॉमिनी की जन्म तिथि",
      "type": "string",
      "required": true,
      "group": "nominee",
      "section": "nominee",
      "bank_varies": true,
      "voice_hints": ["day, month, and year"],
      "ask_en": "What is the nominee's date of birth?",
      "ask_hi": "नॉमिनी की जन्म तिथि बताएं।"
    },
    {
      "id": "nominee_address",
      "label_en": "Nominee address",
      "label_hi": "नॉमिनी का पता",
      "type": "string",
      "required": true,
      "group": "nominee",
      "section": "nominee",
      "bank_varies": true,
      "voice_hints": ["address as you would write it on the form"],
      "ask_en": "What is the nominee's address?",
      "ask_hi": "नॉमिनी का पता बताएं।"
    },
    {
      "id": "nominee_is_minor",
      "label_en": "Nominee is a minor",
      "label_hi": "नॉमिनी नाबालिग है",
      "type": "boolean",
      "required": true,
      "group": "nominee",
      "section": "nominee",
      "bank_varies": true,
      "voice_hints": ["under 18, or say not a minor"],
      "ask_en": "Is the nominee a minor?",
      "ask_hi": "क्या नॉमिनी नाबालिग है?",
      "notes": "Filled from the date of birth when that date is known. Guardian name and address are required only when this is yes."
    },
    {
      "id": "guardian_name",
      "label_en": "Guardian name",
      "label_hi": "अभिभावक का नाम",
      "type": "string",
      "required": false,
      "required_if": { "nominee_is_minor": true },
      "group": "guardian",
      "section": "guardian",
      "bank_varies": true,
      "voice_hints": ["required when the nominee is under 18"],
      "ask_en": "The nominee is a minor. What is the guardian's name?",
      "ask_hi": "नॉमिनी नाबालिग है। अभिभावक का नाम बताएं।"
    },
    {
      "id": "guardian_address",
      "label_en": "Guardian address",
      "label_hi": "अभिभावक का पता",
      "type": "string",
      "required": false,
      "required_if": { "nominee_is_minor": true },
      "group": "guardian",
      "section": "guardian",
      "bank_varies": true,
      "voice_hints": ["required when the nominee is under 18"],
      "ask_en": "What is the guardian's address?",
      "ask_hi": "अभिभावक का पता बताएं।"
    },
    {
      "id": "readback_confirmed",
      "label_en": "I reviewed the filled details and corrections.",
      "type": "boolean",
      "required": true,
      "group": "confirm_gates",
      "section": "confirm_gates",
      "bank_varies": false
    },
    {
      "id": "draft_only_ack",
      "label_en": "I understand this saves a draft only.",
      "type": "boolean",
      "required": true,
      "group": "confirm_gates",
      "section": "confirm_gates",
      "bank_varies": false
    },
    {
      "id": "no_live_submit_ack",
      "label_en": "I understand nothing is submitted to a bank.",
      "type": "boolean",
      "required": true,
      "group": "confirm_gates",
      "section": "confirm_gates",
      "bank_varies": false
    }
  ],
