    },
    {
      "id": "nominee_name",
      "label_en": "Nominee name",
      "label_hi": "नॉमिनी का नाम",
      "type": "string",
      "required": true,
      "group": "nominee",
      "section": "nominee",
      "bank_varies": true,
      "voice_hints": ["person who should receive the balance"],
      "ask_en": "What is the nominee's name?",
      "ask_hi": "नॉमिनी का नाम बताएं।"
    },
    {
      "id": "nominee_relationship",
      "label_en": "Nominee relationship",
